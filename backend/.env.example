# Porta em que a API vai rodar localmente
PORT=3333

# Ambiente: development | production | test
NODE_ENV=development

# Origem(ns) permitida(s) para CORS (separadas por vírgula).
# Em produção, inclua a URL da Vercel (ex.: https://bora-ve-imperatriz.vercel.app).
# Hosts *.vercel.app também são aceitos pelo backend.
CORS_ORIGIN=http://localhost:3000

# Credenciais do projeto Supabase (Project Settings > API)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=coloque-a-service-role-key-aqui

# Segredo usado para assinar tokens/sessões (gerar um valor aleatório forte)
JWT_SECRET=troque-por-um-valor-secreto-aleatorio

# Google Maps Platform — Places API (New). Nunca exponha no frontend.
# A Geocoding API clássica não é usada: o bairro é resolvido pela própria Places.
# Esta chave NÃO serve para login. O login do Google usa o cliente OAuth abaixo.
GOOGLE_MAPS_API_KEY=cole-a-chave-aqui

# URL pública desta API (o provedor redireciona para ela). Sem barra no final.
API_PUBLIC_URL=http://localhost:3333

# Para onde a API devolve o navegador depois do login social.
FRONTEND_URL=http://localhost:3000

# Google Cloud → cliente OAuth "aplicativo da Web".
# Redirect: http://localhost:3333/api/auth/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Meta for Developers → Facebook Login.
# Redirect: http://localhost:3333/api/auth/oauth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Apple Developer → Services ID + chave Sign in with Apple (.p8).
# O callback precisa ser HTTPS; a Apple não aceita http://localhost.
# APPLE_PRIVATE_KEY é o PEM, com quebras de linha escritas como \n.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_SERVICE_ID=
APPLE_PRIVATE_KEY=
